<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>



<VBox spacing="16.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.kevmartins.agendapostit.gui.TelaCalendarioController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox fx:id="areaConteudo" spacing="20.0" VBox.vgrow="ALWAYS">

        <VBox fx:id="colunaEsquerda" spacing="12.0" HBox.hgrow="ALWAYS">
            <VBox spacing="12.0" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="painel-direito">
                <HBox spacing="12.0" alignment="CENTER">
                    <Button fx:id="botaoMesAnterior" onAction="#mesAnterior"/>
                    <Label fx:id="rotuloMes" text="Mês"/>
                    <Button fx:id="botaoMesSeguinte" onAction="#mesSeguinte"/>
                </HBox>
                <GridPane fx:id="gradeDias" hgap="6.0" vgap="6.0" VBox.vgrow="ALWAYS" maxWidth="Infinity"/>
            </VBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="barra-acoes">
                <Button fx:id="botaoNovaTarefa" text="Nova tarefa" onAction="#aoClicarNovaTarefa"
                        styleClass="botao-novo"/>
            </HBox>
        </VBox>

        <VBox fx:id="colunaDireita" spacing="12.0" minWidth="300.0" maxWidth="420.0">
            <VBox fx:id="painelDireito" spacing="12.0" VBox.vgrow="ALWAYS" styleClass="painel-direito">
                <Label fx:id="rotuloDiaSelecionado" text="Selecione um dia"/>

                <VBox fx:id="painelVazio" spacing="12.0" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <ImageView fx:id="ilustracao" fitWidth="140" preserveRatio="true"/>
                    <Label text="Escolha um dia no calendário para ver e gerenciar suas tarefas."
                           wrapText="true" textAlignment="CENTER" styleClass="texto-vazio"/>
                </VBox>

                <ListView fx:id="listaTarefas" VBox.vgrow="ALWAYS"/>
            </VBox>

            <HBox spacing="10.0" alignment="CENTER" styleClass="barra-acoes">
                <Button fx:id="botaoConcluir" text="Concluir" onAction="#aoConcluir"
                        styleClass="botao-concluir"/>
                <Button fx:id="botaoEditar" text="Editar" onAction="#aoEditar"
                        styleClass="botao-editar"/>
                <Button fx:id="botaoRemover" text="Remover" onAction="#aoRemover"
                        styleClass="botao-remover"/>
            </HBox>
        </VBox>

    </HBox>

</VBox>