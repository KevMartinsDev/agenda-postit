<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.kevmartins.agendapostit.gui.TelaFormularioController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Nova tarefa"/>

    <Label text="Título"/>
    <TextField fx:id="campoTitulo"/>

    <Label text="Data"/>
    <DatePicker fx:id="campoData"/>

    <Label text="Horário (HH:mm)"/>
    <TextField fx:id="campoHorario"/>

    <Label text="Descrição (opcional)"/>
    <TextArea fx:id="campoDescricao" prefRowCount="3"/>

    <HBox spacing="10.0">
        <Button text="Salvar" onAction="#aoSalvar"/>
        <Button text="Cancelar" onAction="#aoCancelar"/>
    </HBox>

</VBox>